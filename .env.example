# 本地测试用：复制成 .env 并填好，然后 http://... 手动 source
# 线上不用这个文件 —— GitHub Actions 里配 Secrets 即可

# DeepSeek API（platform.deepseek.com 创建，形如 sk-xxxxxxxx）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# QQ 邮箱 SMTP（授权码不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=2960792563@qq.com
SMTP_PASS=十六位授权码
MAIL_TO=2960792563@qq.com

# 可选
FROM_NAME=AI 新闻日报
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
